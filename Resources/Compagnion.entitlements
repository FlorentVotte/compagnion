<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Notarization requires the hardened runtime, which blocks Apple Events
         unless the app opts back in. Without this, the NSAppleScript in
         HostAppResolver that focuses a Terminal/iTerm2 tab fails with
         errAEEventNotPermitted (-1743) in release builds only. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
